<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Common\order_messages.proto" />
    <None Remove="Common\payment_messages.proto" />
    <None Remove="Common\product_messages.proto" />
    <None Remove="Protos\order.proto" />
    <None Remove="Protos\payment.proto" />
    <None Remove="Protos\Product\product.proto" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Common\order_messages.proto" GrpcServices="None" />
    <Protobuf Include="Common\payment_messages.proto" GrpcServices="None" />
    <Protobuf Include="Common\product_messages.proto" GrpcServices="None" />
    <Protobuf Include="Protos\Order\order.proto" GrpcServices="Both" />
    <Protobuf Include="Protos\Payment\payment.proto" GrpcServices="Both" />
    <Protobuf Include="Protos\Product\product.proto" GrpcServices="Both" />
  </ItemGroup>

</Project>
