{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Key": "k9#mP8$vL2_qXw7!zB4*yN3%hRt6&jF1-dC0+sA5_9fGhJkLmNoPqRsTuVwXyZ",
    "Issuer": "API%&*&680*%$2345*54",
    "Audience": "API495497697876437",
    "ExpiryMinutes": 60
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "https://localhost:4200",
